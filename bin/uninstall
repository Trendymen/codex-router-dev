#!/bin/sh
set -eu

if [ "$(/usr/bin/uname -s 2>/dev/null || printf unknown)" != "Darwin" ]; then
  printf 'codex-router: unsupported_platform\n' >&2
  exit 2
fi

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
target=${MODEL_ROUTER_TARGET:-codex}
case "$target" in
  codex|dsh|gemini) ;;
  *) echo "MODEL_ROUTER_TARGET must be codex, dsh, or gemini." >&2; exit 2 ;;
esac
# Snapshot happens before the client config, skills, shim, service, or runtime
# is touched. The Node boundary owns the entire callback and restores the
# resolver-bound snapshot before restarting the old service on any failure.
# Its callback runs `src/service.mjs uninstall` before `src/skills-install.mjs uninstall`
# when this is the last client, preserving the old stop-before-skills ordering.
node src/local-uninstall.mjs --router-runtime --client-target "$target"
echo "The repository, cached native catalog, logs, and provider credentials were retained."
