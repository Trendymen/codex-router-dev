#!/bin/sh
set -eu

sh "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/platform-gate"

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
# Codex-only on purpose. This toggle drives `multi_agent_version` and the
# Codex agents directory's native encrypted payloads.
if [ "${MODEL_ROUTER_TARGET:-codex}" != codex ]; then
  echo "Only the Codex target has a public multi-agent operation." >&2
  exit 2
fi

command=${1:-status}
case "$command" in
  status|on|off) ;;
  *) echo "Usage: $0 status|on|off" >&2; exit 2 ;;
esac

if [ "$command" = "on" ] || [ "$command" = "off" ]; then
  desired=0
  if [ "$command" = "on" ]; then desired=1; fi
  node --input-type=module -e \
    'import { writeAllMultiAgent } from "./src/multi-agent-state.mjs"; writeAllMultiAgent(process.argv[1] === "1")' \
    "$desired"
  node src/catalog.mjs
fi

node --input-type=module -e \
  'import { readAllMultiAgent, MULTI_AGENT_ALL_PATH } from "./src/multi-agent-state.mjs"; process.stdout.write((readAllMultiAgent() ? "on" : "off") + " " + MULTI_AGENT_ALL_PATH + "\n")'
