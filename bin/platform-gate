#!/bin/sh
set -eu

# Never resolve uname through PATH: a caller-controlled PATH must not be able
# to impersonate Darwin before a mutating public wrapper starts.
if [ "$(/usr/bin/uname -s 2>/dev/null || printf unknown)" != "Darwin" ]; then
  printf 'codex-router: unsupported_platform\n' >&2
  exit 2
fi
