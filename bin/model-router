#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

usage() {
  cat <<'EOF'
Usage: model-router TARGET COMMAND [arguments]

Targets:
  codex   the Codex CLI and desktop app

The shipped target is Codex CLI/Desktop on macOS. One installation owns one
router service, one provider selection, and one credential plane.

Commands:
  setup, install, doctor, status, provider-key, providers, enable, disable,
  multi-agent, media, panel, protocol-proof, uninstall, smoke-test, start, stop, update,
  rollback, shim

Examples:
  ./bin/model-router codex doctor
  ./bin/model-router codex status
  ./bin/model-router codex panel
  ./bin/model-router codex shim install
EOF
}

version() {
  node -p 'require(process.argv[1]).version' "$repo_dir/package.json"
}

if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  version
  exit 0
fi

if [ "$#" -eq 2 ] && [ "$1" = "codex" ] && [ "$2" = "--version" ]; then
  version
  exit 0
fi

if [ "${1:-}" != "--help" ] && [ "$(/usr/bin/uname -s 2>/dev/null || printf unknown)" != "Darwin" ]; then
  printf 'codex-router: unsupported_platform\n' >&2
  exit 2
fi

if [ "$#" -lt 2 ]; then
  usage >&2
  exit 2
fi

target=$1
command=$2
shift 2

case "$target" in
  codex) ;;
  *) echo "Unknown target: $target" >&2; usage >&2; exit 2 ;;
esac

case "$command" in
  setup|install|doctor|status|provider-key|providers|enable|disable|multi-agent|media|panel|protocol-proof|uninstall|smoke-test|start|stop|update|rollback|shim) ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac

if [ "$command" = "protocol-proof" ] && [ "$target" != "codex" ]; then
  echo "protocol-proof is only supported for the codex target." >&2
  exit 2
fi

MODEL_ROUTER_TARGET=$target
export MODEL_ROUTER_TARGET
if [ "$command" = "protocol-proof" ]; then
  exec node "$repo_dir/src/control.mjs" protocol-proof "$@"
fi
exec "$repo_dir/bin/$command" "$@"
