{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.openai.com/schemas/model-catalog-0.147.json",
  "title": "Codex 0.147 routed model catalog",
  "type": "object",
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "model_messages"],
        "properties": {
          "slug": { "type": "string" },
          "model_messages": {
            "type": "object",
            "required": ["instructions_template"],
            "properties": { "instructions_template": { "type": "string" } }
          },
        }
      }
    }
  }
}
