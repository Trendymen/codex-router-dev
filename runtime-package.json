  "assets": [
    "apps/desktop/ui",
    "apps/macos/ModelRouterTray",
    "config"
  ],
  "docs": [
    "README.md",
    "SECURITY.md",
    "docs/INSTALL.md",
    "docs/DEVIN-CLI-PROBE.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/start.mjs",
    "doctor": "node src/doctor.mjs",
